RESEND_API_KEY=
CONTACT_EMAIL_TO=hello@fieldcraft.digital
CONTACT_EMAIL_FROM=noreply@fieldcraft.digital

# GA4 measurement ID (e.g. G-ABC123DEF4). When unset or left as a placeholder,
# the gtag scripts are not injected and event tracking no-ops safely.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Calendly booking URL for the /brief inline widget. Overrides calendly.url in
# src/content/links.json. While unset, the widget shows a placeholder note.
NEXT_PUBLIC_CALENDLY_URL=
